<Project>
  <!--
    Cấu hình chung cho mọi project .NET trong solution.
    Số phiên bản theo Semantic Versioning (CLAUDE.md mục 8): chỉ đổi khi phát hành.
  -->
  <PropertyGroup>
    <Version>0.9.0</Version>
    <Product>Procurement &amp; Inventory</Product>
    <Company>Tổng công ty</Company>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Sinh file XML doc để kiểm tra ghi chú /// <summary> bắt buộc (CLAUDE.md mục 6). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <!-- Project test không bắt buộc XML doc cho từng hàm test. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('Tests'))">
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
</Project>
