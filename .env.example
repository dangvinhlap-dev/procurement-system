# Mẫu cấu hình chạy server cho docker-compose.yml. Copy thành .env (KHÔNG đưa .env lên Git) rồi đổi mọi giá trị "doi-...".

# Phiên bản image app (khớp tag git, ví dụ v0.1.0 → 0.1.0). Quay lại bản cũ: đổi số này rồi docker compose up -d.
APP_VERSION=0.1.0
# Bỏ trống thì dùng image build tại máy (docker compose build); hoặc ghi image trên registry, ví dụ ghcr.io/<tai-khoan>/proc-app
APP_IMAGE=proc-app

# Tên miền (Caddy tự cấp HTTPS) hoặc :80 nếu chỉ chạy HTTP trong mạng nội bộ.
SITE_ADDRESS=:80

# CSDL PostgreSQL
POSTGRES_DB=procurement
POSTGRES_USER=proc
POSTGRES_PASSWORD=doi-mat-khau-csdl

# Khóa ký JWT: chuỗi ngẫu nhiên dài ít nhất 32 ký tự. Đổi khóa thì mọi người phải đăng nhập lại.
# Sinh khóa: openssl rand -base64 48
JWT_SIGNING_KEY=doi-khoa-ngau-nhien-dai-it-nhat-32-ky-tu

# Tài khoản quản trị tạo lần đầu (đã có thì không đổi mật khẩu). Đăng nhập rồi đổi mật khẩu ngay.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=doi-Mat-khau-1

# Tổng công ty tạo lần đầu.
HEAD_OFFICE_CODE=TCT
HEAD_OFFICE_NAME=Tổng công ty

# Mật khẩu admin của Seq (xem log kỹ thuật) – chỉ dùng lần chạy đầu.
SEQ_ADMIN_PASSWORD=doi-mat-khau-seq

# Sao lưu mỗi ngày lúc BACKUP_TIME, giữ BACKUP_KEEP_DAYS ngày.
BACKUP_TIME=01:00
BACKUP_KEEP_DAYS=14
