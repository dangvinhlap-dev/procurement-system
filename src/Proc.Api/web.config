<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình IIS khi cài trên Windows Server (docs/deploy-windows.md). Docker không dùng file này.
  dotnet publish tự điền processPath/arguments của thẻ aspNetCore; các phần khác giữ nguyên:
  - Gỡ WebDAV: module này của IIS chặn PUT/DELETE (API dùng PUT/DELETE để sửa, xóa) và trả 405.
  - Giới hạn body 30 MB: file đính kèm, file Excel nhập tối đa 20 MB (design.md mục 18.1, 18.4) cộng phần bao multipart.
-->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules>
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Proc.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
      <security>
        <requestFiltering>
          <requestLimits maxAllowedContentLength="31457280" />
        </requestFiltering>
      </security>
    </system.webServer>
  </location>
</configuration>
