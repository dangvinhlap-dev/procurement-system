{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "procurement-system",
    "Audience": "procurement-web",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Attachments": {
    "RootPath": "data/attachments",
    "MaxFileSizeMb": 2
  },
  "Printing": {
    "FontDirectories": []
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "Auto",
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Phần mềm mua hàng",
    "AppBaseUrl": "",
    "PollSeconds": 30,
    "BatchSize": 50,
    "MaxAgeHours": 24,
    "MaxAttempts": 5
  },
  "ApprovalReminder": {
    "Enabled": true,
    "PollMinutes": 15,
    "MaxReminders": 3
  },
  "Portal": {
    "BaseUrl": "",
    "Audience": "procurement-portal",
    "TokenLifetimeMinutes": 120,
    "InviteValidHours": 168,
    "PasswordResetValidMinutes": 60,
    "OtpValidMinutes": 10,
    "OtpMaxAttempts": 5,
    "MaxFailedLogins": 5,
    "LockoutMinutes": 15,
    "ExposeCodesForTesting": false,
    "TestServer": false,
    "Hosts": "",
    "RateLimit": {
      "AuthPermitPerMinute": 20,
      "ApiPermitPerMinute": 300
    }
  },
  "AllowedHosts": "*"
}
