{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "Jwt": {
    "Issuer": "procurement-system",
    "Audience": "procurement-web",
    "SigningKey": "",
    "LifetimeMinutes": 480
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "Seed": {
    "Enabled": false
  },
  "Modules": {
    "InventoryEnabled": false
  },
  "Attachments": {
    "RootPath": "data/attachments",
    "MaxFileSizeMb": 2
  },
  "Printing": {
    "FontDirectories": []
  },
  "Email": {
    "Enabled": false,
    "Host": "",
    "Port": 587,
    "Security": "Auto",
    "UserName": "",
    "Password": "",
    "FromAddress": "",
    "FromName": "Phần mềm mua hàng",
    "AppBaseUrl": "",
    "PollSeconds": 30,
    "BatchSize": 50,
    "MaxAgeHours": 24,
    "MaxAttempts": 5
  },
  "AllowedHosts": "*"
}
